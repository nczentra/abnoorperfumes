# ==========================================
# AB NOOR PERFUMES - ENVIRONMENT VARIABLES
# ==========================================

# Firebase Web App Configuration
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=ab-noor-perfumes.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ab-noor-perfumes
VITE_FIREBASE_STORAGE_BUCKET=ab-noor-perfumes.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Razorpay Payment Gateway (Public Key only on client)
# Backend secrets must be in Firebase Cloud Functions, never here!
VITE_RAZORPAY_KEY_ID=rzp_test_YourTestKeyId

# Application URL
VITE_APP_URL=http://localhost:5173

# Secure External Backend API URL (for Razorpay signature verification & Resend emails)
# Private keys are securely maintained in server/.env only!
VITE_BACKEND_API_URL=http://localhost:5000
